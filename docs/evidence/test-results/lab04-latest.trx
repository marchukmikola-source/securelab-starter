      SELECT s.id, s.title, s.description, s.c, s.c0, s.occurred_at_utc, s.created_at_utc, s."DisplayName", s."Id0", s0.id, s0."DisplayName", s0.text, s0.created_at_utc, s0."Id0"&#xD;
      FROM (&#xD;
          SELECT i.id, i.title, i.description, i.severity::text AS c, i.status::text AS c0, i.occurred_at_utc, i.created_at_utc, i0."DisplayName", i0."Id" AS "Id0"&#xD;
          FROM incidents AS i&#xD;
          INNER JOIN identity_users AS i0 ON i.owner_user_id = i0."Id"&#xD;
