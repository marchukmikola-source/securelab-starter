{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Search": {
      "PermitLimit": 30,
      "WindowSeconds": 10
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "AllowReset": false
  }
}
